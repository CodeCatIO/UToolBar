<Window x:Class="EdgeBar.Views.ClipboardPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板"
        Width="376" Height="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="PopupItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="8,7" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.2" Color="#99372A1C" />
        </Border.Effect>

        <Grid Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="剪贴板" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="数字键快选 · Enter 复制 · Esc 关闭" FontSize="8.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource InputBox}" Tag="搜索复制过的内容" Margin="0,0,0,8" TextChanged="OnSearchChanged" />

            <ListBox x:Name="ClipList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource PopupItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnListDoubleClick"
                     PreviewMouseRightButtonDown="OnListRightClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Number}" FontSize="9.5" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />

                            <Grid Grid.Column="1" Width="34" Height="34" Margin="2,0,8,0" VerticalAlignment="Center">
                                <Border CornerRadius="8" Background="{StaticResource AccentSoft}">
                                    <TextBlock Text="文" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentDeep}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Item.IsImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="8" Background="{StaticResource AccentSoft}" ClipToBounds="True"
                                        Visibility="{Binding Item.IsImage, Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding Item.Image}" Stretch="UniformToFill" Width="34" Height="34" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Item.PreviewText}" FontSize="11" TextTrimming="CharacterEllipsis" MaxHeight="30" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Item.TimeText}" FontSize="8.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="2,6,2,0">
                <TextBlock x:Name="CountText" FontSize="8.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right" Text="右键更多 · ↑↓ 选择" FontSize="8.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
            </Grid>

            <!-- 修改文字内容 -->
            <Grid x:Name="EditOverlay" Grid.RowSpan="4" Background="#66000000" Visibility="Collapsed">
                <Border Width="300" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{StaticResource CardBg}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1"
                        CornerRadius="14" Padding="14">
                    <StackPanel>
                        <TextBlock Text="修改内容" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBox x:Name="EditTextBox" Style="{StaticResource InputBox}" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="110" VerticalContentAlignment="Top" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="取消" Margin="0,0,6,0" Click="OnEditCancel" />
                            <Button Style="{StaticResource PrimaryButton}" Content="保存" Click="OnEditSave" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

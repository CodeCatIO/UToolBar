<UserControl x:Class="EdgeBar.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             Focusable="True">

    <UserControl.Resources>
        <Style x:Key="CalcTab" TargetType="ToggleButton">
            <Setter Property="Height" Value="35" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnitPill" TargetType="ToggleButton" BasedOn="{StaticResource CalcTab}">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
        </Style>

        <Style x:Key="CalcKey" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="Foreground" Value="{StaticResource TaskText}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B3FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalcFnKey" TargetType="Button" BasedOn="{StaticResource CalcKey}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <Style x:Key="CalcDangerKey" TargetType="Button" BasedOn="{StaticResource CalcKey}">
            <Setter Property="Foreground" Value="#FFDD6B5F" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="CalcEqKey" TargetType="Button" BasedOn="{StaticResource CalcKey}">
            <Setter Property="Background" Value="#FF1E1E20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="17" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="1,0,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,0,13,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 计算 / 日期 / 换算 -->
        <Border Grid.Row="0" Height="41" Background="{StaticResource GlassStrip}" CornerRadius="10" Padding="3,3" Margin="0,0,0,12">
            <UniformGrid Columns="3">
                <ToggleButton x:Name="TabStandard" Style="{StaticResource CalcTab}" Content="计算" IsChecked="True" Click="OnTabClick" Tag="0" />
                <ToggleButton x:Name="TabDate" Style="{StaticResource CalcTab}" Content="日期" Click="OnTabClick" Tag="1" />
                <ToggleButton x:Name="TabUnit" Style="{StaticResource CalcTab}" Content="换算" Click="OnTabClick" Tag="2" />
            </UniformGrid>
        </Border>

        <Grid Grid.Row="1">
            <!-- 科学计算 -->
            <Grid x:Name="StandardPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource GlassFill}" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ExprText" Text="按 = 计算" FontSize="10" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ResultText" Grid.Row="1" Text="0" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{StaticResource TaskText}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="0" Style="{StaticResource IconButton}" Width="24" Height="24"
                                HorizontalAlignment="Left" Click="OnCopyResult" ToolTip="复制结果">
                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource StrokeIcon}" Width="11" Height="11" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CalcDangerKey}" Content="C" Tag="C" Click="OnKeyClick" />
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CalcFnKey}" Content="⌫" Tag="B" Click="OnKeyClick" />
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CalcFnKey}" Content="(" Tag="(" Click="OnKeyClick" />
                    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource CalcFnKey}" Content=")" Tag=")" Click="OnKeyClick" />
                    <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource CalcFnKey}" Content="÷" Tag="/" Click="OnKeyClick" />

                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CalcFnKey}" Content="x²" Tag="SQ" Click="OnKeyClick" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CalcFnKey}" Content="√x" Tag="SQRT" Click="OnKeyClick" />
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CalcFnKey}" Content="1/x" Tag="INV" Click="OnKeyClick" />
                    <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource CalcFnKey}" Content="±" Tag="NEG" Click="OnKeyClick" />
                    <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource CalcFnKey}" Content="×" Tag="*" Click="OnKeyClick" />

                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource CalcKey}" Content="7" Tag="7" Click="OnKeyClick" />
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CalcKey}" Content="8" Tag="8" Click="OnKeyClick" />
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CalcKey}" Content="9" Tag="9" Click="OnKeyClick" />
                    <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource CalcFnKey}" Content="%" Tag="%" Click="OnKeyClick" />
                    <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource CalcFnKey}" Content="−" Tag="-" Click="OnKeyClick" />

                    <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource CalcKey}" Content="4" Tag="4" Click="OnKeyClick" />
                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource CalcKey}" Content="5" Tag="5" Click="OnKeyClick" />
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CalcKey}" Content="6" Tag="6" Click="OnKeyClick" />
                    <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource CalcKey}" Content="." Tag="." Click="OnKeyClick" />
                    <Button Grid.Row="3" Grid.Column="4" Style="{StaticResource CalcFnKey}" Content="+" Tag="+" Click="OnKeyClick" />

                    <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource CalcKey}" Content="1" Tag="1" Click="OnKeyClick" />
                    <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource CalcKey}" Content="2" Tag="2" Click="OnKeyClick" />
                    <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource CalcKey}" Content="3" Tag="3" Click="OnKeyClick" />
                    <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource CalcKey}" Content="0" Tag="0" Click="OnKeyClick" />
                    <Button Grid.Row="4" Grid.Column="4" Style="{StaticResource CalcEqKey}" Content="=" Tag="=" Click="OnKeyClick" />
                </Grid>

                <TextBlock Grid.Row="2" Text="键盘也能直接算：数字 / 运算符 / 回车，Esc 清空"
                           FontSize="8.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </Grid>

            <!-- 日期 -->
            <ScrollViewer x:Name="DatePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Height="39" Background="{StaticResource GlassStrip}" CornerRadius="10" Padding="3,3" Margin="0,0,0,12">
                        <UniformGrid Columns="3">
                            <ToggleButton x:Name="DateTabDiff" Style="{StaticResource CalcTab}" Content="日期差" IsChecked="True" Click="OnDateModeClick" Tag="0" />
                            <ToggleButton x:Name="DateTabWork" Style="{StaticResource CalcTab}" Content="工作日" Click="OnDateModeClick" Tag="1" />
                            <ToggleButton x:Name="DateTabAge" Style="{StaticResource CalcTab}" Content="年龄" Click="OnDateModeClick" Tag="2" />
                        </UniformGrid>
                    </Border>

                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="开始日期" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox x:Name="Date1Box" Style="{StaticResource InputBox}" Width="185" HorizontalAlignment="Right"
                                 Tag="yyyy-MM-dd" TextChanged="OnDateInputChanged" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="结束日期" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox x:Name="Date2Box" Style="{StaticResource InputBox}" Width="185" HorizontalAlignment="Right"
                                 Tag="yyyy-MM-dd" TextChanged="OnDateInputChanged" />
                    </Grid>

                    <Border Background="{StaticResource GlassFill}" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="DateResultBig" Text="1" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TaskText}" />
                            <TextBlock x:Name="DateResultUnit" Text="天" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0" />
                            <TextBlock x:Name="DateResultSub" Text="≈ 0 周 1 天" FontSize="9.5" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="法定节假日已内置 2024–2026（2026 为暂定，以国务院办公厅公布为准）；之后的年份按周末自动排除。"
                               FontSize="8.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="1,12,1,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- 换算 -->
            <ScrollViewer x:Name="UnitPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <UniformGrid Columns="6" Margin="0,0,0,12">
                        <ToggleButton x:Name="UnitCurrency" Style="{StaticResource UnitPill}" Content="货币" Tag="货币" IsChecked="True" Click="OnUnitCategoryClick" />
                        <ToggleButton x:Name="UnitLength" Style="{StaticResource UnitPill}" Content="长度" Tag="长度" Click="OnUnitCategoryClick" />
                        <ToggleButton x:Name="UnitWeight" Style="{StaticResource UnitPill}" Content="重量" Tag="重量" Click="OnUnitCategoryClick" />
                        <ToggleButton x:Name="UnitArea" Style="{StaticResource UnitPill}" Content="面积" Tag="面积" Click="OnUnitCategoryClick" />
                        <ToggleButton x:Name="UnitTemp" Style="{StaticResource UnitPill}" Content="温度" Tag="温度" Click="OnUnitCategoryClick" />
                        <ToggleButton x:Name="UnitVolume" Style="{StaticResource UnitPill}" Content="体积" Tag="体积" Click="OnUnitCategoryClick" />
                    </UniformGrid>

                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="数值" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBox x:Name="UnitValueBox" Style="{StaticResource InputBox}" Width="185" HorizontalAlignment="Right"
                                 Text="1" TextChanged="OnUnitValueChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="UnitFromCombo" Style="{StaticResource DarkComboBox}" SelectionChanged="OnUnitSelectionChanged" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="5,1,5,0"
                                Click="OnSwapUnits" ToolTip="交换单位">
                            <TextBlock Text="⇄" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                        </Button>
                        <ComboBox x:Name="UnitToCombo" Grid.Column="2" Style="{StaticResource DarkComboBox}" SelectionChanged="OnUnitSelectionChanged" />
                    </Grid>

                    <Border Background="{StaticResource GlassFill}" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="UnitResultText" Text="—" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{StaticResource TaskText}" TextTrimming="CharacterEllipsis" />
                                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="24" Height="24"
                                        Click="OnCopyUnitResult" ToolTip="复制结果">
                                    <Path Data="{StaticResource IconCopy}" Style="{StaticResource StrokeIcon}" Width="11" Height="11" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="UnitRateText" FontSize="9.5" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" />
                            <Grid Margin="0,5,0,0">
                                <TextBlock x:Name="UnitUpdateText" FontSize="8.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                <Button x:Name="BtnRefreshRate" HorizontalAlignment="Right" Style="{StaticResource SoftButton}"
                                        Height="24" Content="刷新汇率" Click="OnRefreshRates" Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="UnitNoteText" Text="货币按内置参考汇率换算，实际以银行成交价为准；长度、重量等按国际标准单位换算。"
                               FontSize="8.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="1,12,1,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

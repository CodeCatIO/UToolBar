<UserControl x:Class="UToolBar.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="2,0,0,9" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="3" CornerRadius="2" Background="{StaticResource Stroke}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="{StaticResource TextPrimary}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="ToolOrderRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CreamBg}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="ToolOrderBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AppearanceToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppearanceSelected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppearanceSelected}" />
                                <Setter Property="Foreground" Value="{StaticResource AppearanceSelectedText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Rectangle x:Name="Backdrop" IsHitTestVisible="False" Fill="{StaticResource SettingsBackdrop}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="12,10,12,8" Height="40">
            <Button HorizontalAlignment="Left" Style="{StaticResource IconButton}" Width="30" Height="30" Click="OnBackClick" ToolTip="返回">
                <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource StrokeIcon}" Width="10" Height="10" />
            </Button>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="VersionText" Text="UTB v2.3.0" FontSize="8.5" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,12,14">
            <StackPanel>
                <!-- 显示器 -->
                <TextBlock Text="显示器" Style="{StaticResource SectionTitle}" Margin="2,4,0,8" />
                <Border Style="{StaticResource Card}" Padding="12,11" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="MonitorHint" Text="" FontSize="9" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ComboBox x:Name="MonitorCombo" Style="{StaticResource DarkComboBox}" Height="32" SelectionChanged="OnMonitorChanged" />
                    </StackPanel>
                </Border>

                <!-- 外观 -->
                <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,11" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="LightButton" Grid.Column="0" Style="{StaticResource AppearanceToggle}" Click="OnAppearanceClick">
                                <TextBlock Text="浅色" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </ToggleButton>
                            <ToggleButton x:Name="DarkButton" Grid.Column="2" Style="{StaticResource AppearanceToggle}" Click="OnAppearanceClick">
                                <TextBlock Text="深色" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </ToggleButton>
                        </Grid>
                        <StackPanel x:Name="RestartHint" Orientation="Horizontal" Visibility="Collapsed" Margin="2,10,0,0">
                            <TextBlock Text="切换外观需要重启后生效" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <Button x:Name="BtnRestart" Style="{StaticResource SoftButton}" Content="立即重启" Height="24" Margin="8,0,0,0" Click="OnRestartClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 窗口 -->
                <TextBlock Text="窗口" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,1">
                            <TextBlock Text="面板宽度" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="PanelWidthValue" Text="364px" Style="{StaticResource SliderValue}" />
                        </Grid>
                        <Slider x:Name="PanelWidthSlider" Style="{StaticResource SettingSlider}" Minimum="320" Maximum="440" ValueChanged="OnSliderChanged" Tag="width" />

                        <Grid Margin="0,6,0,1">
                            <TextBlock Text="可见把手宽度" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="HandleWidthValue" Text="40px" Style="{StaticResource SliderValue}" />
                        </Grid>
                        <Slider x:Name="HandleWidthSlider" Style="{StaticResource SettingSlider}" Minimum="32" Maximum="52" ValueChanged="OnSliderChanged" Tag="handleWidth" />

                        <Grid Margin="0,6,0,1">
                            <TextBlock Text="把手高度" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="HandleHeightValue" Text="84px" Style="{StaticResource SliderValue}" />
                        </Grid>
                        <Slider x:Name="HandleHeightSlider" Style="{StaticResource SettingSlider}" Minimum="64" Maximum="120" ValueChanged="OnSliderChanged" Tag="handleHeight" />

                        <Grid Margin="0,6,0,1">
                            <TextBlock Text="垂直位置" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="HandleVerticalValue" Text="50%" Style="{StaticResource SliderValue}" />
                        </Grid>
                        <Slider x:Name="HandleVerticalSlider" Style="{StaticResource SettingSlider}" Minimum="10" Maximum="90" ValueChanged="OnSliderChanged" Tag="handleVertical" />
                    </StackPanel>
                </Border>

                <!-- 任务 -->
                <TextBlock Text="任务" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Height="32">
                            <TextBlock Text="显示已完成" Style="{StaticResource SettingLabel}" />
                            <ToggleButton x:Name="ShowCompletedSwitch" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="OnTaskSettingChanged" Unchecked="OnTaskSettingChanged" />
                        </Grid>

                        <Grid Margin="0,4,0,1">
                            <TextBlock Text="行高" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="RowHeightValue" Text="44px" Style="{StaticResource SliderValue}" />
                        </Grid>
                        <Slider x:Name="RowHeightSlider" Style="{StaticResource SettingSlider}" Minimum="36" Maximum="60" ValueChanged="OnSliderChanged" Tag="rowHeight" />

                        <Grid Margin="0,6,0,1">
                            <TextBlock Text="行间距" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="RowSpacingValue" Text="7px" Style="{StaticResource SliderValue}" />
                        </Grid>
                        <Slider x:Name="RowSpacingSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="16" ValueChanged="OnSliderChanged" Tag="rowSpacing" />

                        <Grid Margin="0,6,0,1">
                            <TextBlock Text="文字大小" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="TaskFontSizeValue" Text="12.5px" Style="{StaticResource SliderValue}" />
                        </Grid>
                        <Slider x:Name="TaskFontSizeSlider" Style="{StaticResource SettingSlider}" Minimum="11" Maximum="18" ValueChanged="OnSliderChanged" Tag="fontSize" />

                        <Grid Margin="0,8,0,2">
                            <TextBlock Text="字体" Style="{StaticResource SettingLabel}" />
                            <ComboBox x:Name="TaskFontCombo" Width="140" Height="28" HorizontalAlignment="Right"
                                      Style="{StaticResource DarkComboBox}" SelectionChanged="OnTaskFontChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 观感 -->
                <TextBlock Text="观感" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,1">
                            <TextBlock Text="面板圆角" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="PanelRadiusValue" Text="18px" Style="{StaticResource SliderValue}" />
                        </Grid>
                        <Slider x:Name="PanelRadiusSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="30" ValueChanged="OnSliderChanged" Tag="radius" />

                        <Grid Margin="0,6,0,1">
                            <TextBlock Text="不透明度" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="PanelOpacityValue" Text="91%" Style="{StaticResource SliderValue}" />
                        </Grid>
                        <Slider x:Name="PanelOpacitySlider" Style="{StaticResource SettingSlider}" Minimum="50" Maximum="100" ValueChanged="OnSliderChanged" Tag="opacity" />

                        <Border Height="78" Margin="0,8,0,2" CornerRadius="10" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6FA6D6" Offset="0" />
                                    <GradientStop Color="#FFF3D18A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border x:Name="AppearancePreview" CornerRadius="18,0,0,18" Margin="0" />
                                <TextBlock Text="观感预览" FontSize="9" Foreground="White" Opacity="0.85"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 顶栏工具顺序 -->
                <TextBlock Text="顶栏工具" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="前 4 个显示在顶栏，其余收进「更多」；用 ↑ ↓ 调整顺序。"
                                   FontSize="9" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel x:Name="ToolOrderList" />
                    </StackPanel>
                </Border>

                <!-- Gitee 同步 -->
                <TextBlock Text="同步（Gitee）" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="手动上传 / 下拉，不会自动同步；私人令牌只保存在本机，不会写入云端。仓库需为公开或提供有 contents 权限的私人令牌。"
                                   FontSize="9" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GiteeOwnerBox" Style="{StaticResource InputBox}" Tag="仓库所有者" Height="30" />
                            <TextBox x:Name="GiteeRepoBox" Grid.Column="2" Style="{StaticResource InputBox}" Tag="仓库名" Height="30" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GiteeBranchBox" Style="{StaticResource InputBox}" Tag="分支" Height="30" />
                            <TextBox x:Name="GiteePathBox" Grid.Column="2" Style="{StaticResource InputBox}" Tag="文件路径" Height="30" />
                        </Grid>
                        <TextBox x:Name="GiteeTokenBox" Style="{StaticResource InputBox}" Tag="私人令牌（仅保存在本机）" Height="30" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BlackPill}" Height="28" Padding="12,0" Click="OnGiteeUpload">
                                <TextBlock Text="上传数据" Foreground="White" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Height="28" Margin="6,0,0,0" Content="下拉数据" Click="OnGiteePull" />
                        </StackPanel>
                        <TextBlock x:Name="SyncStatusText" FontSize="9" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <!-- 背景 -->
                <TextBlock Text="背景" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="10,10,4,2" Margin="0,0,0,12">
                    <ItemsControl x:Name="ThemeList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Tile" Margin="0,0,6,6" CornerRadius="10" BorderThickness="1.5"
                                        Cursor="Hand" MouseLeftButtonUp="OnThemeClick"
                                        Tag="{Binding Key}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentDeep}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Height="68">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>
                                        <Border CornerRadius="8,8,0,0" ClipToBounds="True">
                                            <Rectangle Fill="{Binding Brush}" />
                                        </Border>
                                        <Border Grid.Row="1" Background="#44000000" CornerRadius="0,0,8,8">
                                            <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentDeep}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="✓" FontSize="9.5" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 桌面 -->
                <TextBlock Text="桌面" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Height="34">
                            <TextBlock Text="开机自动登录" Style="{StaticResource SettingLabel}" />
                            <ToggleButton x:Name="AutoStartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged" />
                        </Grid>
                        <Grid Height="34">
                            <TextBlock Text="点击外部自动收起" Style="{StaticResource SettingLabel}" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.AutoHide, Mode=TwoWay}" />
                        </Grid>
                        <Grid Height="34">
                            <TextBlock Text="启动时展开" Style="{StaticResource SettingLabel}" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.StartExpanded, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 功能 -->
                <TextBlock Text="功能" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Height="34">
                            <TextBlock Text="提醒提示音" Style="{StaticResource SettingLabel}" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.SoundEnabled, Mode=TwoWay}" />
                        </Grid>
                        <Grid Height="34">
                            <TextBlock Text="剪贴板最多保留" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="60 条" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="34">
                            <TextBlock Text="截图默认工具" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="箭头" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="30">
                            <TextBlock Text="截图保存位置" Style="{StaticResource SettingLabel}" />
                            <TextBlock x:Name="ShotFolderText" FontSize="9" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       MaxWidth="190" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Button Style="{StaticResource GhostButton}" Content="修改截图保存位置" Height="26"
                                HorizontalAlignment="Left" Margin="0,0,0,6" Click="OnChangeScreenshotFolder" />
                    </StackPanel>
                </Border>

                <!-- 快捷键 -->
                <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Height="27">
                            <TextBlock Text="新建便签" Style="{StaticResource SettingLabel}" Foreground="{StaticResource TextSecondary}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource CreamBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="5" Padding="5,2">
                                <TextBlock Text="Alt + N" FontSize="9" Foreground="{StaticResource TextSecondary}" />
                            </Border>
                        </Grid>
                        <Grid Height="27">
                            <TextBlock Text="区域截图" Style="{StaticResource SettingLabel}" Foreground="{StaticResource TextSecondary}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource CreamBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="5" Padding="5,2">
                                <TextBlock Text="Ctrl + Alt + A" FontSize="9" Foreground="{StaticResource TextSecondary}" />
                            </Border>
                        </Grid>
                        <Grid Height="27">
                            <TextBlock Text="剪贴板浮窗" Style="{StaticResource SettingLabel}" Foreground="{StaticResource TextSecondary}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource CreamBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="5" Padding="5,2">
                                <TextBlock Text="Ctrl + Alt + V" FontSize="9" Foreground="{StaticResource TextSecondary}" />
                            </Border>
                        </Grid>
                        <Grid Height="27">
                            <TextBlock Text="展开 / 收起" Style="{StaticResource SettingLabel}" Foreground="{StaticResource TextSecondary}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource CreamBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="5" Padding="5,2">
                                <TextBlock Text="Ctrl + Alt + B" FontSize="9" Foreground="{StaticResource TextSecondary}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 数据 -->
                <TextBlock Text="数据" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="DataPathText" FontSize="9" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,9" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Style="{StaticResource SoftButton}" Content="修改保存位置" Height="26" Click="OnChangeDataFolder" />
                            <Button Style="{StaticResource GhostButton}" Content="打开数据文件夹" Height="26" Margin="6,0,0,0" Click="OnOpenDataFolder" />
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Content="清空剪贴板记录" Height="26" HorizontalAlignment="Left" Click="OnClearClips" />
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="UToolBar · 统一工具条" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="本地优先 · 数据只保存在这台电脑" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GhostButton}"
                                Height="26" Foreground="{StaticResource Danger}" Content="退出 UToolBar" Click="OnExitClick" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

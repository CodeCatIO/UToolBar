<UserControl x:Class="EdgeBar.Views.SalaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Margin" Value="2,0,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 今日已赚 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="15,12" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <TextBlock Text="今日已赚" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" Background="{StaticResource AccentFaint}" CornerRadius="8" Padding="7,3">
                        <TextBlock x:Name="StatusText" Text="疯狂搬砖" FontSize="9.5" Foreground="{StaticResource Accent}" />
                    </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="¥" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Bottom" Margin="0,0,4,5" />
                    <TextBlock x:Name="EarnedText" Text="0.00" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
                <TextBlock x:Name="EarnedSubText" Text="今天还没开始" FontSize="9.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- 三个小指标 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="日薪" FontSize="9" Foreground="{StaticResource TextMuted}" />
                    <TextBlock x:Name="DailyText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="时薪" FontSize="9" Foreground="{StaticResource TextMuted}" />
                    <TextBlock x:Name="HourlyText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="每秒" FontSize="9" Foreground="{StaticResource TextMuted}" />
                    <TextBlock x:Name="PerSecondText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 倒计时 -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCard}" Padding="12,9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="下班倒计时" FontSize="9" Foreground="{StaticResource TextMuted}" />
                        <TextBlock x:Name="OffCountdownText" Text="--:--:--" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource StrokeIcon}" Width="10" Height="10"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.4" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="12,9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="距离发薪" FontSize="9" Foreground="{StaticResource TextMuted}" />
                        <TextBlock x:Name="PaydayText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="PaydaySubText" Text="" FontSize="9" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- 设置 -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="计薪设置" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,10" />

                        <TextBlock Text="月薪（元）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SalaryBox" Style="{StaticResource InputBox}"
                                 Text="{Binding Salary.MonthlySalary, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="上班时间" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource InputBox}"
                                         Text="{Binding Salary.WorkStart, UpdateSourceTrigger=LostFocus}" Tag="09:00" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="下班时间" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource InputBox}"
                                         Text="{Binding Salary.WorkEnd, UpdateSourceTrigger=LostFocus}" Tag="18:00" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="每月发薪日" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding Salary.PayDay, UpdateSourceTrigger=LostFocus}" Tag="15" />

                        <Button x:Name="BtnSalaryWidget" Style="{StaticResource SoftButton}" Content="把今日已赚贴到桌面"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnWidgetClick" />
                    </StackPanel>
                </Border>
                <TextBlock Text="日薪按 21.75 个工作日折算 · 数据只保存在本机" FontSize="9"
                           Foreground="{StaticResource TextMuted}" Margin="2,6,0,2" HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

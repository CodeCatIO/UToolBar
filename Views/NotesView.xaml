<UserControl x:Class="UToolBar.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:UToolBar.Converters"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <conv:HexBrushConverter x:Key="HexBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="NoteCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource GlassFillHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="15,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="CountText" FontSize="10" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            <Button x:Name="BtnAddNote" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource BlackPill}" Height="28" Padding="12,0" Click="OnNewNote">
                <TextBlock Text="+ 贴一张" Foreground="White" FontSize="11" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,1,4,0">
                <ItemsControl x:Name="NoteList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource NoteCard}" MouseLeftButtonDown="OnNoteClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="36" Height="46" CornerRadius="9"
                                            Background="{Binding ColorHex, Converter={StaticResource HexBrush}}"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconNote}" Stretch="Uniform" Width="14" Height="14"
                                              Fill="#80181B22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PreviewTitle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="点击打开便签" FontSize="9" Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Text=" · 已钉住" FontSize="9" Foreground="{StaticResource Accent}"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource MiniButton}" ToolTip="删除便签" Click="OnDeleteClick">
                                            <Path Data="{StaticResource IconTrash}" Style="{StaticResource StrokeIcon}" Width="11" Height="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="桌面上还没有便签" FontSize="12.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                <TextBlock Text="Alt+N 随手贴一张，关机也不丢" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" HorizontalAlignment="Center" />
                <Button Style="{StaticResource SoftButton}" Content="贴第一张" HorizontalAlignment="Center" Margin="0,12,0,0" Click="OnNewNote" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="便签会贴在桌面上，重启后回到原来的位置" FontSize="8.5"
                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,2" />
    </Grid>
</UserControl>

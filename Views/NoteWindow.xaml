<Window x:Class="EdgeBar.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:EdgeBar.Converters"
        Title="便签"
        Width="264" Height="224"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <conv:HexBrushConverter x:Key="HexBrush" />

        <Style x:Key="NoteIconButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B3181B22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotePinButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <Grid>
                                <Path x:Name="Ico" Data="{StaticResource IconPin}" Fill="#8C181B22" Stretch="Uniform" Width="12" Height="12" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ico" Property="Fill" Value="#FF1F8F73" />
                                <Setter TargetName="Bd" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            CornerRadius="14"
            Background="{Binding ColorHex, Converter={StaticResource HexBrush}}"
            BorderBrush="#26000000" BorderThickness="1"
            Opacity="{Binding Opacity}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.35" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部拖动区 -->
            <Border Grid.Row="0" Background="#10000000" CornerRadius="14,14,0,0" Padding="12,6" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <TextBlock Text="贴边便签" FontSize="10" Foreground="#8C181B22" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource NoteIconButton}" Width="46" ToolTip="转为今日待办" Click="OnConvertClick" Padding="0">
                            <TextBlock Text="转待办" FontSize="9.5" Foreground="#B3181B22" />
                        </Button>
                        <ToggleButton x:Name="PinBtn" Style="{StaticResource NotePinButton}" ToolTip="钉在最前" Checked="OnPinChanged" Unchecked="OnPinChanged" />
                        <Button Style="{StaticResource NoteIconButton}" ToolTip="删除便签" Click="OnDeleteClick">
                            <Path Data="{StaticResource IconTrash}" Stroke="#B3181B22" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 正文 -->
            <TextBox x:Name="BodyBox"
                     Grid.Row="1"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     Margin="14,8,14,4"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#E6181B22" CaretBrush="#FF1F8F73"
                     SelectionBrush="#55227A63"
                     FontFamily="Microsoft YaHei UI, Segoe UI"
                     FontSize="12.5" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Tag="写点什么…" />

            <!-- 底部工具栏 -->
            <Grid Grid.Row="2" Margin="12,2,30,8">
                <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="13" Height="13" Margin="0,0,6,0" Fill="#FFF3C4" Tag="#FFF3C4" Cursor="Hand" MouseLeftButtonDown="OnColorClick" StrokeThickness="2" Stroke="Transparent" />
                    <Ellipse Width="13" Height="13" Margin="0,0,6,0" Fill="#CDEFE4" Tag="#CDEFE4" Cursor="Hand" MouseLeftButtonDown="OnColorClick" StrokeThickness="2" Stroke="Transparent" />
                    <Ellipse Width="13" Height="13" Margin="0,0,6,0" Fill="#D7E4FF" Tag="#D7E4FF" Cursor="Hand" MouseLeftButtonDown="OnColorClick" StrokeThickness="2" Stroke="Transparent" />
                    <Ellipse Width="13" Height="13" Margin="0,0,6,0" Fill="#FFD9DE" Tag="#FFD9DE" Cursor="Hand" MouseLeftButtonDown="OnColorClick" StrokeThickness="2" Stroke="Transparent" />
                    <Ellipse Width="13" Height="13" Margin="0,0,6,0" Fill="#E6DAFF" Tag="#E6DAFF" Cursor="Hand" MouseLeftButtonDown="OnColorClick" StrokeThickness="2" Stroke="Transparent" />
                    <Ellipse Width="13" Height="13" Fill="#F0E4D0" Tag="#F0E4D0" Cursor="Hand" MouseLeftButtonDown="OnColorClick" StrokeThickness="2" Stroke="Transparent" />
                </StackPanel>
                <Button x:Name="OpacityBtn" HorizontalAlignment="Right" Style="{StaticResource NoteIconButton}" Width="44" ToolTip="点击切换透明度" Click="OnOpacityClick">
                    <TextBlock x:Name="OpacityText" Text="{Binding OpacityPercentText}" FontSize="9.5" Foreground="#A6181B22" />
                </Button>
            </Grid>

            <!-- 右下角缩放把手 -->
            <Border Grid.RowSpan="3" Width="22" Height="22" Margin="0,0,3,3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="Transparent" Cursor="SizeNWSE" ToolTip="拖动调整便签大小"
                    MouseLeftButtonDown="OnResizeGripDown"
                    MouseMove="OnResizeGripMove"
                    MouseLeftButtonUp="OnResizeGripUp"
                    LostMouseCapture="OnResizeGripLostCapture">
                <Path Data="M5,16 L16,5 M10,17 L17,10 M15,18 L18,15"
                      Stroke="#66181B22" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,2,2" IsHitTestVisible="False" />
            </Border>
        </Grid>
    </Border>
</Window>

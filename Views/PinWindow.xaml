<Window x:Class="EdgeBar.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="贴图"
        Width="320" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Border x:Name="Root" CornerRadius="12" Background="Transparent"
            MouseLeftButtonDown="OnDrag"
            MouseWheel="OnWheel"
            MouseEnter="OnMouseEnter"
            MouseLeave="OnMouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <Grid>
            <Border CornerRadius="12" ClipToBounds="True" Background="White">
                <Image x:Name="Pic" Stretch="Uniform" />
            </Border>

            <Border x:Name="ToolBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                    Background="#F2FFFFFF" BorderBrush="#FFE8E1D7" BorderThickness="1" CornerRadius="8" Padding="2"
                    Opacity="0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="OnCopyClick" ToolTip="复制图片">
                        <Path Data="{StaticResource IconCopy}" Style="{StaticResource StrokeIcon}" Width="11" Height="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="OnCloseClick" ToolTip="关闭贴图">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource StrokeIcon}" Width="9" Height="9" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

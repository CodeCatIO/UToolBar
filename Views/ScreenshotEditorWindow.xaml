                                <Border Height="3" CornerRadius="2" Background="{StaticResource Stroke}" VerticalAlignment="Center" Margin="9,0" />
                                <Slider x:Name="RSlider" Style="{StaticResource RingSlider}" Minimum="0" Maximum="255" ValueChanged="OnChannelChanged" Tag="R" />
                            </Grid>
                            <TextBox x:Name="RBox" Grid.Column="2" Style="{StaticResource InputBox}" Height="24" FontSize="10" TextChanged="OnRgbaChanged" />
                        </Grid>
                        <Grid Height="28" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="G" FontSize="8.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="2,0,6,0">
                                <Border Height="3" CornerRadius="2" Background="{StaticResource Stroke}" VerticalAlignment="Center" Margin="9,0" />
                                <Slider x:Name="GSlider" Style="{StaticResource RingSlider}" Minimum="0" Maximum="255" ValueChanged="OnChannelChanged" Tag="G" />
                            </Grid>
                            <TextBox x:Name="GBox" Grid.Column="2" Style="{StaticResource InputBox}" Height="24" FontSize="10" TextChanged="OnRgbaChanged" />
                        </Grid>
                        <Grid Height="28" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" FontSize="8.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="2,0,6,0">
                                <Border Height="3" CornerRadius="2" Background="{StaticResource Stroke}" VerticalAlignment="Center" Margin="9,0" />
                                <Slider x:Name="BSlider" Style="{StaticResource RingSlider}" Minimum="0" Maximum="255" ValueChanged="OnChannelChanged" Tag="B" />
                            </Grid>
                            <TextBox x:Name="BBox" Grid.Column="2" Style="{StaticResource InputBox}" Height="24" FontSize="10" TextChanged="OnRgbaChanged" />
                        </Grid>
                        <Grid Height="28" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="A" FontSize="8.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="2,0,6,0">
                                <Border Height="3" CornerRadius="2" Background="{StaticResource Stroke}" VerticalAlignment="Center" Margin="9,0" />
                                <Slider x:Name="ASlider" Style="{StaticResource RingSlider}" Minimum="0" Maximum="255" Value="255" ValueChanged="OnAlphaChanged" />
                            </Grid>
                            <TextBox x:Name="ABox" Grid.Column="2" Style="{StaticResource InputBox}" Height="24" FontSize="10" TextChanged="OnRgbaChanged" />
                        </Grid>

                        <TextBox x:Name="HexBox" Style="{StaticResource InputBox}" Height="26" FontSize="10"
                                 Margin="0,8,0,0" KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />

                        <WrapPanel x:Name="PalettePanel" Width="232" Margin="0,8,0,0" />

                        <Button Style="{StaticResource GhostButton}" Content="屏幕取色" Height="28" Margin="0,8,0,0" Click="OnEyedropperClick" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>

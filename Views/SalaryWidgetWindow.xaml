<Window x:Class="EdgeBar.Views.SalaryWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计薪组件"
        Width="244" Height="132"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">

    <Border CornerRadius="16" Background="White" BorderBrush="#FFEDE6DB" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#99372A1C" />
        </Border.Effect>

        <Grid Margin="14,11,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="今日已赚" FontSize="9.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                        Width="22" Height="22" Opacity="0" Click="OnCloseClick" ToolTip="关闭组件">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource StrokeIcon}" Width="8" Height="8" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="¥" FontSize="12" Foreground="{StaticResource AccentDeep}" Margin="0,0,3,4" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="EarnedText" Text="0.00" FontSize="27" FontWeight="SemiBold" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="7,3">
                    <TextBlock x:Name="StatusText" Text="搬砖中" FontSize="8.5" Foreground="{StaticResource AccentDeep}" />
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,7,0,0">
                <TextBlock x:Name="OffText" Text="下班 --:--:--" FontSize="8.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                <TextBlock x:Name="PaydayText" Text="发薪 —" FontSize="8.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>

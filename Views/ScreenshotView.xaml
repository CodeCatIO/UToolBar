<UserControl x:Class="EdgeBar.Views.ScreenshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="15,0,13,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="截完直接标注，钉在桌面当参考" FontSize="9.5" Foreground="{StaticResource TextMuted}" />
        </StackPanel>

        <!-- 区域截图 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoft}">
                    <Path Data="{StaticResource IconCamera}" Style="{StaticResource StrokeIcon}" Stroke="{StaticResource AccentDeep}" Width="21" Height="21" />
                </Border>

                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="区域截图" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="拖动选择区域，松开后进入标注" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="BtnRegionShot" Style="{StaticResource PrimaryButton}" Content="截取" Height="28" Click="OnRegionClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 全屏 / 窗口 -->
        <Grid Grid.Row="2" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="全屏截图" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="截取整个桌面" FontSize="8.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,8" />
                    <Button x:Name="BtnFullShot" Style="{StaticResource SoftButton}" Content="立即截取" HorizontalAlignment="Left" Height="26" Click="OnFullScreenClick" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="窗口截图" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="截取当前最前窗口" FontSize="8.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,8" />
                    <Button x:Name="BtnWindowShot" Style="{StaticResource SoftButton}" Content="立即截取" HorizontalAlignment="Left" Height="26" Click="OnWindowClick" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 屏幕录制 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoft}">
                    <Path Data="M3,6 H21 A2,2 0 0 1 23,8 V18 A2,2 0 0 1 21,20 H3 A2,2 0 0 1 1,18 V8 A2,2 0 0 1 3,6 Z M9,9.5 V16.5 L15.5,13 Z"
                          Style="{StaticResource StrokeIcon}" Stroke="{StaticResource AccentDeep}" Width="22" Height="22" />
                </Border>

                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="屏幕录制" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Ctrl + Alt + S，可选声音、清晰度与格式" FontSize="9"
                               Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="录屏" Height="28" Click="OnRecordClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 说明 -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="标注工具" FontSize="10.5" FontWeight="SemiBold" />
                <TextBlock Text="箭头 · 画笔 · 矩形 · 文字 · 马赛克，支持撤销" FontSize="9.5"
                           Foreground="{StaticResource TextSecondary}" Margin="0,5,0,10" TextWrapping="Wrap" />

                <TextBlock Text="输出方式" FontSize="10.5" FontWeight="SemiBold" />
                <TextBlock Text="复制到剪贴板、保存为 PNG，或「贴到桌面」当参考图" FontSize="9.5"
                           Foreground="{StaticResource TextSecondary}" Margin="0,5,0,10" TextWrapping="Wrap" />

                <TextBlock Text="小技巧" FontSize="10.5" FontWeight="SemiBold" />
                <TextBlock Text="贴图后滚轮缩放，Ctrl + 滚轮调透明度；Ctrl + Alt + A 可随时开始区域截图"
                           FontSize="9.5" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap" />

                <Border Height="1" Background="{StaticResource Stroke}" Margin="0,12,0,10" />
                <TextBlock Text="Ctrl + Alt + A · 区域截图" FontSize="8.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="UToolBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UToolBar.Views"
        Title="UToolBar"
        Width="382" Height="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Deactivated="OnWindowDeactivated"
        Closing="OnWindowClosing">

    <Grid x:Name="Root" ClipToBounds="True">
        <!-- 抽屉：宽度 382，收起时整体右移 340，只露出左侧把手 -->
        <Grid x:Name="Drawer" HorizontalAlignment="Left">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DrawerSlide" X="0" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HandleColumn" Width="40" />
                <ColumnDefinition x:Name="PanelColumn" Width="364" />
            </Grid.ColumnDefinitions>

            <!-- 展开后的面板 -->
            <Border x:Name="Panel" Grid.Column="1"
                    CornerRadius="18,0,0,18"
                    Background="Transparent"
                    BorderBrush="#59FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.22" Color="#FF20364A" />
            </Border.Effect>

            <Grid>
                <!-- 全幅插画背景 -->
                <Grid x:Name="BackgroundLayer">
                    <Rectangle x:Name="ThemeBackdrop" Fill="#FFF7FAFD" />
                    <Rectangle Fill="{StaticResource ModeScrim}" IsHitTestVisible="False" />
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#26FFFFFF" Offset="0" />
                                <GradientStop Color="#0AFFFFFF" Offset="0.22" />
                                <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                <GradientStop Color="#14FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <Grid x:Name="ContentRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="69" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶栏 -->
                    <Grid Grid.Row="0">
                        <Border IsHitTestVisible="False" VerticalAlignment="Top" Height="82"
                                Background="{StaticResource TopScrim}" />

                        <StackPanel x:Name="HomeHeader" Orientation="Horizontal" VerticalAlignment="Top"
                                    Margin="15,16,0,0">
                            <Image Source="/Assets/icon.png" Width="28" Height="28"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   ToolTip="UToolBar · 统一工具条" />
                            <TextBlock Text="UTB" FontSize="16" FontWeight="Bold" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"
                                       ToolTip="UToolBar · 统一工具条" />
                        </StackPanel>

                        <StackPanel x:Name="ToolHeader" Orientation="Horizontal" VerticalAlignment="Top"
                                    Margin="12,15,0,0" Visibility="Collapsed">
                            <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                    Click="OnBackClick" ToolTip="返回">
                                <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource StrokeIcon}"
                                      Width="9" Height="9" StrokeThickness="1.8" />
                            </Button>
                            <TextBlock x:Name="ToolTitle" Text="计算器" FontSize="15" FontWeight="SemiBold"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 右侧图标坞：按设置动态生成，前 4 个工具 + 更多 + 设置 -->
                        <StackPanel x:Name="Dock" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="0,12,8,0" />
                    </Grid>

                    <!-- 功能页：按需创建，首次打开时才实例化，避免启动即加载 8 个页面 -->
                    <Grid x:Name="PageHost" Grid.Row="1" />

                    <!-- 更多工具浮层 -->
                    <Grid x:Name="MoreHost" Grid.RowSpan="2" Visibility="Collapsed"
                          Background="#12000000" MouseLeftButtonDown="OnMoreBackdropClick">
                        <Border x:Name="MorePanel" Width="248" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,46,8,0"
                                Background="{StaticResource CardBg}" CornerRadius="16" Padding="10" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.16" Color="#FF2C4257" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock x:Name="MoreTitle" Text="更多工具" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                           Margin="6,2,0,8" />
                                <UniformGrid x:Name="MoreGrid" Columns="2">
                                    <Button Style="{StaticResource MoreItem}" Tag="1" Click="OnMoreToolClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconGift}" Style="{StaticResource DockIcon}" Width="16" Height="16" />
                                            <TextBlock Text="纪念日" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MoreItem}" Tag="3" Click="OnMoreToolClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCalendar}" Style="{StaticResource DockIcon}" Width="16" Height="16" />
                                            <TextBlock Text="万年历" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MoreItem}" Tag="4" Click="OnMoreToolClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconWallet}" Style="{StaticResource DockIcon}" Width="16" Height="16" />
                                            <TextBlock Text="牛马计薪" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MoreItem}" Click="OnMoreNewNote">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource DockIcon}" Width="15" Height="15" />
                                            <TextBlock Text="新建便签" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MoreItem}" Click="OnMoreDataFolder">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource DockIcon}" Width="16" Height="16" />
                                            <TextBlock Text="数据目录" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MoreItem}" Click="OnSettingsClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconGear}" Style="{StaticResource DockIcon}" Width="16" Height="16" />
                                            <TextBlock Text="侧栏设置" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 设置整页 -->
                    <Grid x:Name="SettingsHost" Grid.RowSpan="2" Visibility="Collapsed">
                        <views:SettingsView x:Name="SettingsPage" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 贴边小把手：沿用主题壁纸，左侧圆角，和面板连成一体 -->
        <Border x:Name="HandleTab" Grid.Column="0" Width="40" Height="84"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                CornerRadius="16,0,0,16"
                Background="#F7FAFD"
                Cursor="Hand"
                MouseLeftButtonUp="OnHandleClick"
                ToolTip="收起 / 展开 UTB">
            <Grid>
                <Border x:Name="HandleFrost" Background="#A6FFFFFF" CornerRadius="16,0,0,16" />
                <Path x:Name="HandleChevron" Data="M10,2 L4,9 L10,16"
                      Stroke="#2B2B31" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="Uniform" Width="8" Height="13"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
